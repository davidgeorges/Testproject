{
  "expo": {
    "name": "Clarysio",
    "slug": "subscription-project",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/clarysio-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "subscriptionapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidgeorges.subscriptionapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "scheme": [
        "subscriptionapp",
        "com.googleusercontent.apps.120450519440-d2ipa2rlo7u17vborla4h50u3f6cf7sh"
      ]
    },
    "android": {
      "package": "com.davidgeorges.subscriptionapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/clarysio-icon.png",
        "backgroundColor": "#17181B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "b55cc19c-4ea7-410d-891c-7fe38657a84f"
      }
    },
    "owner": "azetoxvii",
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l’accès à vos photos pour importer un document.",
          "cameraPermission": "Autorisez l’appareil photo pour scanner un document.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17181B",
          "image": "./assets/clarysio-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
